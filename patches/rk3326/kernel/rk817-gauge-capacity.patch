From ccb9f696e191ad47d720919ddd42fdfd8250444e Mon Sep 17 00:00:00 2001
From: arkun <56165886+CatalyticArkun@users.noreply.github.com>
Date: Sun, 11 Oct 2026 00:11:08 -0500
Subject: [PATCH] power: rk817_battery: report the fuel gauge SOC, resync a
 stale saved dsoc

rg351 reported a 3.3-3.9 V line of the loaded voltage, so anything above 3.9 V read 100%.
A saved dsoc more than 10% from the counted charge (left by another OS) is reset at probe.
---
 drivers/power/rk817_battery.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/drivers/power/rk817_battery.c b/drivers/power/rk817_battery.c
index 00c0f99..a959240 100644
--- a/drivers/power/rk817_battery.c
+++ b/drivers/power/rk817_battery.c
@@ -1740,6 +1740,12 @@ static void rk817_bat_init_fg(struct rk817_battery_device *battery)
 	rk817_bat_rsoc_init(battery);
 	rk817_bat_init_coulomb_cap(battery, battery->nac);
 	DBG("rsoc%d, fcc = %d\n", battery->rsoc, battery->fcc);
+	/* A saved dsoc left by another OS survives U-Boot's init; start from the counted charge */
+	if (abs(battery->dsoc - battery->rsoc) > 10 * 1000) {
+		BAT_INFO("dsoc %d far from rsoc %d, resync\n", battery->dsoc, battery->rsoc);
+		battery->dsoc = battery->rsoc;
+		rk817_bat_save_dsoc(battery, battery->dsoc);
+	}
 	rk817_bat_init_dsoc_algorithm(battery);
 	battery->qmax = rk817_bat_get_qmax(battery);
 	battery->voltage_avg = rk817_bat_get_battery_voltage(battery);
@@ -2023,7 +2029,7 @@ static int rk817_bat_get_charge_state(struct rk817_battery_device *battery)
 static int rg351p_battery_pre_voltage = 5000;
 #define RG351_BAT_MAX_VOLTAGE 3900
 #define RG351_BAT_MIN_VOLTAGE 3300
-static int rk817_battery_rg351p_capacity_get(int voltage,int charge_status)
+static int __maybe_unused rk817_battery_rg351p_capacity_get(int voltage,int charge_status)
 {
 	if(rg351p_battery_pre_voltage>=5000){
 		rg351p_battery_pre_voltage = RG351_BAT_MAX_VOLTAGE;
@@ -2060,14 +2066,10 @@ static int rk817_battery_get_property(struct power_supply *psy,
 			val->intval = VIRTUAL_VOLTAGE * 1000;
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
-		/*
+		/* The fuel gauge's own SOC, not the RG351P 3.3-3.9 V voltage line */
 		val->intval = (battery->dsoc  + 500) / 1000;
 		if (battery->pdata->bat_mode == MODE_VIRTUAL)
 			val->intval = VIRTUAL_SOC;
-		*/
-		//dev_err(dev, "%d\n",battery->voltage_avg);
-		val->intval = rk817_battery_rg351p_capacity_get(battery->voltage_avg,rk817_bat_get_charge_state(battery));
-		
 		break;
 	case POWER_SUPPLY_PROP_HEALTH:
 		val->intval = POWER_SUPPLY_HEALTH_GOOD;
-- 
