From 8306ffdfb01a03b0231f7811b496082fb2beabf1 Mon Sep 17 00:00:00 2001
From: arkun <56165886+CatalyticArkun@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:07:41 -0500
Subject: [PATCH] power: rk817_charger: pmic_plug_det, a charger from the PMIC
 plug-in status

A board whose charger reaches neither dc_det_gpio nor BC detection never put a charger online, so
the battery read Discharging while charging. With pmic_plug_det, PMIC plug-in means an AC charger.
---
 drivers/power/rk817_charger.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/drivers/power/rk817_charger.c b/drivers/power/rk817_charger.c
index ec2748f..3889433 100644
--- a/drivers/power/rk817_charger.c
+++ b/drivers/power/rk817_charger.c
@@ -281,6 +281,7 @@ struct charger_platform_data {
 	int sample_res;
 	int otg5v_suspend_enable;
 	bool extcon;
+	bool pmic_plug_det;
 };
 
 struct rk817_charger {
@@ -1378,6 +1379,8 @@ static int rk817_charge_parse_dt(struct rk817_charger *charge)
 	pdata->chrg_term_mode = DEFAULT_CHRG_TERM_MODE;
 
 	pdata->extcon = of_property_read_bool(np, "extcon");
+	/* For boards whose charger reaches neither dc_det_gpio nor BC detection */
+	pdata->pmic_plug_det = of_property_read_bool(np, "pmic_plug_det");
 
 	ret = of_property_read_u32(np, "max_chrg_current",
 				   &pdata->max_chrg_current);
@@ -1499,7 +1502,9 @@ static void rk817_charge_irq_delay_work(struct work_struct *work)
 	if (charge->plugin_trigger) {
 		DBG("pmic: plug in\n");
 		charge->plugin_trigger = 0;
-		if (charge->pdata->extcon)
+		if (charge->pdata->pmic_plug_det)
+			rk817_charge_set_chrg_param(charge, USB_TYPE_AC_CHARGER);
+		else if (charge->pdata->extcon)
 			queue_delayed_work(charge->usb_charger_wq, &charge->usb_work,
 					   msecs_to_jiffies(10));
 	} else if (charge->plugout_trigger) {
@@ -1661,6 +1666,11 @@ static int rk817_charge_probe(struct platform_device *pdev)
 		goto irq_fail;
 	}
 
+	/* A charger plugged in before boot raised no plug-in irq */
+	if (charge->pdata->pmic_plug_det &&
+	    rk817_charge_get_plug_in_status(charge))
+		rk817_charge_set_chrg_param(charge, USB_TYPE_AC_CHARGER);
+
 	rk817_chage_debug(charge);
 	DBG("driver version: %s\n", CHARGE_DRIVER_VERSION);
 
@@ -1739,6 +1749,12 @@ static int rk817_charge_pm_resume(struct device *dev)
 	if (charge->otg_slp_state)
 		rk817_charge_otg_slp_enable(charge);
 
+	/* Catch a plug or unplug that happened while suspended */
+	if (charge->pdata->pmic_plug_det)
+		rk817_charge_set_chrg_param(charge,
+					    rk817_charge_get_plug_in_status(charge) ?
+					    USB_TYPE_AC_CHARGER : USB_TYPE_NONE_CHARGER);
+
 	return 0;
 }
 #endif
