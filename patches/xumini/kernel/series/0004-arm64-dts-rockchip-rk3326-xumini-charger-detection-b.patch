From 4388363af85d451e4232b28b86362623f6726256 Mon Sep 17 00:00:00 2001
From: arkun <56165886+CatalyticArkun@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:07:41 -0500
Subject: [PATCH] arm64: dts: rockchip: rk3326-xumini: charger detection by the
 PMIC plug-in status

Measured: the dc_det GPIO stays low whether or not a charger is plugged in, while the PMIC's
PLUG_IN_STS follows it. Needs the rk817_charger pmic_plug_det support (dArkMoss opt-in fix).
---
 arch/arm64/boot/dts/rockchip/rk3326-xumini-linux.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3326-xumini-linux.dts b/arch/arm64/boot/dts/rockchip/rk3326-xumini-linux.dts
index e21f1c5..4ed20b0 100644
--- a/arch/arm64/boot/dts/rockchip/rk3326-xumini-linux.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3326-xumini-linux.dts
@@ -375,6 +375,8 @@
 
 	charger {
 		max_chrg_voltage = <4400>;
+		/* dc_det_gpio is not wired here: charger detection by the PMIC plug-in status */
+		pmic_plug_det;
 	};
 };
 
