[Unit]
Description=Show "Loading..." again after console-setup has reset the console
DefaultDependencies=no
After=console-setup.service
Before=bootlogo.service
ConditionKernelCommandLine=!darkmoss.debug

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bootlogo-loading.sh

[Install]
WantedBy=sysinit.target
