[Unit]
Description=Show "Loading..." on the blank console until the boot logo is drawn
DefaultDependencies=no
# As soon as systemd starts (the initramfs hook printed it first); bootlogo-loading-again
# prints it once more after console-setup. Debug boots show kernel text instead.
Before=console-setup.service bootlogo.service
ConditionKernelCommandLine=!darkmoss.debug

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bootlogo-loading.sh

[Install]
WantedBy=sysinit.target
