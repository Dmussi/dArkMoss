[Unit]
Description=Show the logo with "Shutting down" once the frontend lets go of the panel
DefaultDependencies=no
# The image is on the rootfs: /boot may be unmounted before a shutdown-time unit runs.
ConditionPathExists=/usr/share/bootlogo/logo-poweroff.bmp

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/sbin/bootlogo.py --image /usr/share/bootlogo/logo-poweroff.bmp

[Install]
WantedBy=poweroff.target halt.target
